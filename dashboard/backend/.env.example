DATABASE_URL="file:./dev.db"
PORT=4000
CORS_ORIGIN="http://localhost:5180"

# Correo de notificación (las dos puertas de aprobación son solo aviso; la aprobación
# real se hace en el dashboard). Si no se configuran estas variables, el dashboard
# simula el envío con un mensaje en consola en vez de fallar.
GERENTE_EMAIL="gerente@verdeecologico.com.co"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Credenciales SECOP II por razón social — SOLO para uso manual humano al loguearse
# (resolver captcha) en community.secop.gov.co. NUNCA se usan para login automatizado.
# Agregar una línea por cada empresa/razón social.
SECOP_<NOMBRE_EMPRESA>_USER=
SECOP_<NOMBRE_EMPRESA>_PASS=
